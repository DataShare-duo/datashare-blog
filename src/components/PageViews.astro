---
const { url } = Astro.props;
---

<span class="page-views" id="page-views">阅读量加载中...</span>

<script>
  async function updateViewCount() {
    const element = document.getElementById('page-views');
    if (!element) return;
    try {
      // 为计数器生成唯一标识符
      const pageId = window.location.pathname;
      // 服务提供SVG徽章，我们需要从中提取数字
      const response = await fetch(`https://hits.seeyoufarm.com/api/count/incr/badge.svg?url=${encodeURIComponent(pageId)}`);
      const svgText = await response.text();
      // 用正则提取访问计数，这是作者推荐的方式[17†L29-L31]
      const match = svgText.match(/<text[^>]*fill="#fff"[^>]*>([\d\s/]+)<\/text>/);
      if (match) {
        const count = match[1].trim().split(/\s+/).pop();
        element.textContent = `${count} 次`;
      }
    } catch (error) {
      element.textContent = ' 0 次';
    }
  }

  updateViewCount();
</script>