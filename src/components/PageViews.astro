---
// src/components/PageViews.astro
// 文章阅读次数组件
// - increment=true（默认）：文章详情页，计数 +1，同一 session 刷新不重复
// - increment=false：列表页，只展示不增加
import crypto from 'node:crypto';

interface Props {
  slug?: string;
  increment?: boolean;
}

const { slug, increment = true } = Astro.props;

const rawPath = slug ?? Astro.url.pathname;
const hash = crypto.createHash('md5').update(rawPath).digest('hex').slice(0, 12);
const counterKey = `ds_${hash}`;
---

<span class="page-views" data-counter-key={counterKey} data-increment={String(increment)}>
  阅读量加载中...
</span>

<script>
  (function () {
    const CLASS = 'page-views';
    const API = 'https://countapi.mileshilliard.com/api/v1';
    const FETCH_TIMEOUT_MS = 5000;

    function fetchWithTimeout(url) {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), FETCH_TIMEOUT_MS);
      return fetch(url, { signal: ctrl.signal }).finally(() => clearTimeout(t));
    }

    async function fetchHit(key) {
      const res = await fetchWithTimeout(`${API}/hit/${encodeURIComponent(key)}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const d = await res.json();
      if (d?.value == null) throw new Error('Missing value');
      return d.value;
    }

    async function fetchGet(key) {
      const res = await fetchWithTimeout(`${API}/get/${encodeURIComponent(key)}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const d = await res.json();
      if (d?.value == null) throw new Error('Missing value');
      return d.value;
    }

    function show(el, count) {
      el.textContent = ` ${count} 次`;
    }

    async function initListView(el, key) {
      try {
        const count = await fetchGet(key);
        show(el, count);
        localStorage.setItem(`${key}_cache`, String(count));
      } catch {
        const cached = localStorage.getItem(`${key}_cache`);
        show(el, cached ? parseInt(cached, 10) : 0);
      }
    }

    async function initDetailView(el, key) {
      const sessionKey = `hit_${key}`;

      if (sessionStorage.getItem(sessionKey)) {
        try {
          const count = await fetchGet(key);
          show(el, count);
          localStorage.setItem(`${key}_cache`, String(count));
        } catch {
          const cached = localStorage.getItem(`${key}_cache`);
          show(el, cached ? parseInt(cached, 10) : 0);
        }
        return;
      }

      sessionStorage.setItem(sessionKey, '1');

      try {
        const count = await fetchHit(key);
        show(el, count);
        localStorage.setItem(`${key}_cache`, String(count));
      } catch {
        const stored = localStorage.getItem(key);
        const n = stored ? parseInt(stored, 10) + 1 : 1;
        localStorage.setItem(key, String(n));
        show(el, n);
      }
    }

    async function initElement(el) {
      const key = el.dataset.counterKey;
      if (!key) { el.textContent = ' 0 次'; return; }
      const inc = el.dataset.increment !== 'false';
      if (inc) { await initDetailView(el, key); }
      else     { await initListView(el, key); }
    }

    async function initAll() {
      const els = document.querySelectorAll(`.${CLASS}`);
      if (els.length === 0) return;
      await Promise.allSettled(Array.from(els).map(initElement));
    }

    initAll();

    function onSwupNavigate() { initAll(); }

    if (window.swup) {
      window.swup.hooks.on('page:view', onSwupNavigate);
    } else {
      document.addEventListener('swup:enable', () => {
        window.swup?.hooks.on('page:view', onSwupNavigate);
        initAll();
      });
    }
    document.addEventListener('swup:contentReplaced', onSwupNavigate);
  })();
</script>
