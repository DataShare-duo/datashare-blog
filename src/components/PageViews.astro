---
// src/components/PageViews.astro
export interface Props {
  key?: string;
}
const { key } = Astro.props;
---

<span class="page-views" id="page-views">📖 阅读量加载中...</span>

<script define:vars={{ customKey: key ?? '' }}>
  async function updateViewCount() {
    const element = document.getElementById('page-views');
    if (!element) return;

    // 如果传入了自定义 key 就用它，否则用当前页面路径
    const rawKey = customKey || window.location.pathname;

    // 清理键名：字母、数字、短横线、下划线、斜杠
    const cleanKey = rawKey
      .replace(/^\/+|\/+$/g, '')
      .replace(/[^a-zA-Z0-9-_/]/g, '-')
      .replace(/\/{2,}/g, '/');

    const apiUrl = `https://countapi.mileshilliard.com/api/v1/hit/${encodeURIComponent(cleanKey)}`;

    try {
      const response = await fetch(apiUrl);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json();
      if (data?.value) {
        element.textContent = `${data.value} 次`;
      } else {
        throw new Error('Missing value');
      }
    } catch (error) {
      console.error('Failed to fetch page views:', error);
      element.textContent = '0 次';
    }
  }

  updateViewCount();
</script>
